pragma language_version 0.23;

export ledger globalIndex: Uint<192>;
export ledger lastCheckpointAt: Uint<64>;
export ledger totalShares: Uint<128>;
export ledger userShares: Uint<128>;

export circuit poke(newIndex: Uint<192>, timestamp: Uint<64>): Uint<192> {
    assert(newIndex >= globalIndex, "Index must be non-decreasing");
    globalIndex = disclose(newIndex);
    lastCheckpointAt = disclose(timestamp);
    return globalIndex;
}

export circuit getBalance(shares: Uint<128>, currentIndex: Uint<192>): Uint<128> {
    return shares;
}
