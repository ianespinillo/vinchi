pragma language_version 0.23;

export ledger governor: Bytes<32>;
export ledger guardian: Bytes<32>;
export ledger depositPaused: Boolean;
export ledger payPaused: Boolean;
export ledger materializePaused: Boolean;

export circuit setDepositPaused(paused: Boolean): [] {
    depositPaused = disclose(paused);
}

export circuit setPayPaused(paused: Boolean): [] {
    payPaused = disclose(paused);
}

export circuit setMaterializePaused(paused: Boolean): [] {
    materializePaused = disclose(paused);
}
